import os

configfile: "config.yaml"

REPO_ROOT = os.path.abspath(os.path.join(workflow.basedir, "..", ".."))
workdir: REPO_ROOT

include: "helpers.smk"

AS_LIST = config["rocketfuel"]["as_list"]
ROCKETFUEL_FILETYPE = config["rocketfuel"]["filetype"]

# ────────────────────────────────────────────────────────────────
# Network generation
# ────────────────────────────────────────────────────────────────


# ────────────────────────────────────────────────────────────────
# Simulator
# ────────────────────────────────────────────────────────────────

for proto in PROTOCOLS:
    rule:
        name: f"run_rocketfuel_normal_{proto}"
        input:
            dataset = lambda wc: rocketfuel_dataset_path(wc.as_num, ROCKETFUEL_FILETYPE),
        output:
            output_files(proto, "{as_num}", ROCKETFUEL_FILETYPE),
        params:
            flags = sim_flags(proto),
        shell:
            """
            for i in $(seq 1 {RUNS}); do
                if [ "$i" -eq 1 ]; then
                    append_flag=""
                else
                    append_flag="-A"
                fi
                {SIMULATOR} -f {input.dataset} {params.flags} \
                    -i {PERIOD} -m 0 -a {METRIC_CLI} \
                    $append_flag > /dev/null
            done
            """

rule rocketfuel_normal_convergence:
    input:
        [
            output_file(proto, as_num, ROCKETFUEL_FILETYPE, "convergence")
            for as_num in AS_LIST
            for proto in PROTOCOLS
        ],
